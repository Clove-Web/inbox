{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "inbox",
	"main": "server.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"kv_namespaces": [
		{
			"binding": "MAILBOX_KV",
			"id": "9f2023123d284292b796806f5f314338"
		}
	],
	"vars": {
		"OIDC_SCOPE": "openid profile email",
		"VAPID_SUBJECT": "mailto:admin@doughmination.win",
		"COOKIE_SECURE": "true"
	}
}
