{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "inbox",
	"main": "server.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"kv_namespaces": [
		{
			"binding": "MAILBOX_KV",
			"id": "9f2023123d284292b796806f5f314338"
		}
	],
	"vars": {
		"OIDC_SCOPE": "openid profile email",
		"VAPID_SUBJECT": "mailto:admin@doughmination.win",
		"COOKIE_SECURE": "true",
		"OIDC_ISSUER": "https://sso.doughmination.gay",
		"OIDC_CLIENT_ID": "cc067f21-88ca-4927-ac7b-26d21968d2e1",
		"OIDC_REDIRECT_URI": "https://mail.doughmination.gay/auth/callback",
		"OIDC_POST_LOGOUT_REDIRECT_URI": "https://mail.doughmination.gay",
		"SEND_FROM": "",
		"VAPID_PUBLIC_KEY": "BJs_bZo392RyXRrh4LNcYxJ2qIhPVaOhWqOIVbsC4HTy5IlKmdGrF4bNuFiFOWAe7udwLbCDvjVX03IChs35Lp8"
	}
}
